# =====================================================================
# KeyLogger — Environment Configuration Example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---- Application ----
APP_NAME=KeyLogger
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ---- Backend server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Database (PostgreSQL) ----
# The backend reads DATABASE_URL if set; otherwise composes from the parts below.
POSTGRES_USER=keylogger
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=keylogger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://keylogger:change-me-in-production@localhost:5432/keylogger

# ---- Security / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (Vite) ----
# Consumed by the frontend build; must be prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/api
